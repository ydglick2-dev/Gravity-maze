<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background">

    <LinearLayout
        android:id="@+id/club_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_background"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/club_home"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/club_home"
                android:textColor="@color/toolbar_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/club_reload"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/club_reload"
                android:textColor="@color/toolbar_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/club_external"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/club_external"
                android:textColor="@color/toolbar_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/club_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/club_settings"
                android:textColor="@color/toolbar_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/club_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />

        <WebView
            android:id="@+id/club_web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/club_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/game_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/club_setup_title"
            android:textColor="@color/toolbar_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/club_setup_body"
            android:textColor="@color/muted_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/club_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints="username"
            android:hint="@string/club_url_hint"
            android:inputType="textUri"
            android:textColor="@color/toolbar_text"
            android:textColorHint="@color/muted_text" />

        <Button
            android:id="@+id/club_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/club_save" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/club_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
