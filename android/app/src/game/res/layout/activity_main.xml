<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Deliberately small and dim: the maze owns the screen, this is only a door out to
         the club tab. -->
    <Button
        android:id="@+id/club_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:alpha="0.45"
        android:background="@drawable/bg_club_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/club_chip"
        android:textColor="@color/club_chip_text"
        android:textSize="12sp" />

</FrameLayout>
