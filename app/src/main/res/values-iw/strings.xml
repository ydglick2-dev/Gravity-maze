    <!-- Safe mode -->
    <string name="safe_mode_title">‏Glassify נעצר</string>
    <string name="safe_mode_body">ההפעלה הקודמת נכשלה, ולכן דילגנו על מסך הבית כדי לעצור את לולאת הקריסות. שלח את הפירוט הזה למפתח, או נסה שוב.</string>
