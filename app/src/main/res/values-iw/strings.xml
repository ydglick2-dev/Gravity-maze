    <string name="setup_home_watcher_title">זיהוי מסך הבית</string>
    <string name="setup_home_watcher_body">מאפשר לדוק ולשעון להופיע רק על מסך הבית, במקום מעל כל אפליקציה. ‏Glassify מקבל רק את שם האפליקציה שעלתה לחזית — הוא לא יכול לקרוא תוכן מסך או מה שאתה מקליד.</string>

    <string name="home_watcher_description">מאפשר ל‑Glassify להציג את דוק ושון הזכוכית רק על מסך הבית. הוא קורא איזו אפליקציה בחזית ותו לא.</string>
    <string name="home_watcher_summary">מציג את שכבת הזכוכית רק על מסך הבית</string>

