    <!-- Setup wizard -->
    <string name="setup_welcome_title">Glassify</string>
    <string name="setup_welcome_body">מסך בית מזכוכית נוזלית לטלפון שלך. ארבעה צעדים קצרים וסיימנו.</string>
    <string name="setup_continue">המשך</string>
    <string name="setup_skip">דלג</string>
    <string name="setup_finish">התחל</string>
    <string name="setup_grant">אישור</string>
    <string name="setup_granted">אושר</string>

    <string name="setup_home_title">הגדרה כמסך הבית</string>
    <string name="setup_home_body">בחר ב‑Glassify כברירת מחדל, כדי שלחיצה על „בית” תפתח אותו. אפשר לחזור ללאנצ׳ר הקודם בכל רגע דרך הגדרות אנדרואיד.</string>

    <string name="setup_notifications_title">גישה להתראות</string>
    <string name="setup_notifications_body">נדרשת למרכז ההתראות וכדי שה‑Dynamic Island יציג מה מתנגן. ההתראות נקראות במכשיר בלבד ולא יוצאות ממנו.</string>

    <string name="setup_overlay_title">הצגה מעל אפליקציות אחרות</string>
    <string name="setup_overlay_body">מאפשרת ל‑Dynamic Island ולמרכז ההתראות להופיע מעל כל אפליקציה שפתוחה.</string>

    <string name="setup_battery_title">שהכל ימשיך לרוץ</string>
    <string name="setup_battery_body">‏One UI מרדים אפליקציות רקע באגרסיביות. בלי הפטור הזה ה‑Dynamic Island יפסיק להופיע אחרי כמה דקות.</string>
    <string name="setup_battery_hint">בנוסף, פתח הגדרות ◂ סוללה ◂ הגבלות שימוש ברקע, והוסף את Glassify ל„אפליקציות שלא יורדמו”.</string>

    <string name="setup_wallpaper_title">בחירת טפט</string>
    <string name="setup_wallpaper_body">הזכוכית שוברת את מה שמאחוריה, ולכן Glassify מצייר את הטפט בעצמו. בחר תמונה משלך או אחד מהמובנים.</string>
    <string name="setup_wallpaper_pick">בחירת תמונה</string>

