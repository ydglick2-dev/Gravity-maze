    <string name="settings_edge_trigger_note">עלולה להתנגש עם מחוות לוח ההגדרות המהירות של הטלפון. כבה אותה כדי לפתוח את מרכז ההתראות ממסך הבית בלבד.</string>
    <string name="settings_wallpaper">טפט</string>
    <string name="settings_permissions">הרשאות</string>
    <string name="settings_about">אודות</string>
    <string name="settings_about_body">‏Glassify הוא מסך בית עצמאי. אין לו קשר ל‑Apple Inc.‎, והיא לא מאשרת או מקושרת אליו. האייקונים מעוצבים מחדש מתוך הגרפיקה שכל אפליקציה מספקת בעצמה.</string>
    <string name="settings_licenses">הגופנים Inter ו‑Heebo בשימוש תחת רישיון SIL Open Font License 1.1.</string>

