<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this only needs to give the window the right ground colour so
         there is no white flash between the splash and the first frame. -->
    <style name="Theme.Kolan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kolan_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
