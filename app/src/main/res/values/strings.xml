    <!-- Setup wizard -->
    <string name="setup_welcome_title">Glassify</string>
    <string name="setup_welcome_body">A liquid-glass home screen for your phone. Four quick steps and you are done.</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_skip">Skip</string>
    <string name="setup_finish">Start</string>
    <string name="setup_grant">Grant</string>
    <string name="setup_granted">Granted</string>

    <string name="setup_home_title">Set as home screen</string>
    <string name="setup_home_body">Pick Glassify as the default so that pressing Home opens it. You can switch back to your old launcher at any time in Android settings.</string>

    <string name="setup_notifications_title">Notification access</string>
    <string name="setup_notifications_body">Needed for the Notification Centre and for the Dynamic Island to show what is playing. Notifications are read on the device and never leave it.</string>

    <string name="setup_overlay_title">Draw over other apps</string>
    <string name="setup_overlay_body">Lets the Dynamic Island and the Notification Centre appear on top of whatever you are using.</string>

    <string name="setup_battery_title">Keep it running</string>
    <string name="setup_battery_body">One UI aggressively sleeps background apps. Without this exemption the Dynamic Island stops appearing after a few minutes.</string>
    <string name="setup_battery_hint">Also open Settings ▸ Battery ▸ Background usage limits and add Glassify to “Never sleeping apps”.</string>

    <string name="setup_wallpaper_title">Choose a wallpaper</string>
    <string name="setup_wallpaper_body">The glass refracts whatever is behind it, so Glassify draws the wallpaper itself. Pick one of yours or use a built-in.</string>
    <string name="setup_wallpaper_pick">Choose a photo</string>

