    <!-- Headphone warning -->
    <string name="no_headphones_title">חבר אוזניות</string>
    <string name="no_headphones_body">במצב האזנה חיה בלי אוזניות המיקרופון קולט את הרמקול, הרמקול מנגן את זה שוב, והתוצאה היא צפצוף חד ובלתי נסבל. קוֹלָן חוסמת את זה מראש.\n\nחבר אוזניות חוטיות או בלוטות\' כדי להמשיך.</string>
    <string name="no_headphones_dismiss">הבנתי</string>
    <string name="headphones_disconnected">האוזניות נותקו — הפלט הושתק</string>
    <string name="audio_unavailable_title">לא ניתן לפתוח את המיקרופון</string>
    <string name="audio_unavailable_body">אפליקציה אחרת כנראה מחזיקה במיקרופון, או שהמערכת סירבה לפתוח ערוץ בהשהיה נמוכה. סגור אפליקציות אחרות שמשתמשות במיקרופון ונסה שוב.</string>

    <!-- Loudspeaker -->
    <string name="loudspeaker_warning_title">מצב ניסיוני</string>
    <string name="loudspeaker_warning_body">במצב רמקול קוֹלָן מנגנת את הקול המעובד מהרמקול של הטלפון, בזמן שיחה רגילה שמתנהלת על ספיקר. הצד השני שומע את זה דרך המיקרופון של הטלפון.\n\nחשוב לדעת: מבטל ההד של הצד השני נלחם בדיוק בסוג האודיו הזה, ולכן האיכות תיפגע — קטיעות, עיוותים ולעיתים השתקה מוחלטת. זה מגבלה של הרשת הסלולרית, לא של קוֹלָן.</string>
    <string name="loudspeaker_warning_continue">הבנתי, המשך</string>
    <string name="loudspeaker_active">מצב רמקול פעיל — הצמד את הטלפון לרמקול</string>

