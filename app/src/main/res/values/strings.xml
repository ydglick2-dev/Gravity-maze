<resources>
    <string name="app_name">קוֹלָן</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">ברוכים הבאים לקוֹלָן</string>
    <string name="onboarding_welcome_body">קוֹלָן משנה את הקול שלך בזמן אמת — הזזת גובה הצליל בנפרד מהפורמנטים, כך שהתוצאה נשמעת כמו אדם אחר ולא כמו הקלטה מוארכת.</string>
    <string name="onboarding_reality_title">מה קוֹלָן יכולה ומה לא</string>
    <string name="onboarding_reality_body">אנדרואיד לא מאפשר לאף אפליקציה להזריק אודיו למיקרופון של אפליקציה אחרת. בוואטסאפ, בטלגרם ובשיחות טלפון רגילות — הצד השני תמיד ישמע את הקול הגולמי שלך.\n\nלכן יש כאן שלוש דרכים אמיתיות שבהן מישהו אחר שומע את הקול המשונה: שיחה פנימית בתוך קוֹלָן, הודעה קולית מוקלטת, ומצב רמקול.</string>
    <string name="onboarding_mic_title">גישה למיקרופון</string>
    <string name="onboarding_mic_body">בלי המיקרופון אין מה לעבד. ההרשאה משמשת אך ורק לעיבוד הקול במכשיר שלך — שום דבר לא נשלח לשום שרת אלא אם התחלת שיחה פנימית.</string>
    <string name="onboarding_notification_title">התראה בזמן פעולה</string>
    <string name="onboarding_notification_body">כשהמנוע פועל מוצגת התראה קבועה. בלעדיה אנדרואיד משתיק את המיקרופון ברגע שיוצאים מהאפליקציה. בהתראה יש גם כפתורי עצירה והחלפת פריסט.</string>
    <string name="onboarding_bluetooth_title">אוזניות בלוטות\'</string>
    <string name="onboarding_bluetooth_body">ההרשאה מאפשרת לזהות אילו אוזניות מחוברות ולנתב אליהן את הקול. אם לא תאשר, אוזניות חוטיות עדיין יעבדו.</string>
    <string name="onboarding_grant">אשר הרשאה</string>
    <string name="onboarding_next">המשך</string>
    <string name="onboarding_finish">בוא נתחיל</string>
    <string name="onboarding_skip">דלג</string>
    <string name="onboarding_granted">אושר</string>
    <string name="onboarding_denied_body">ההרשאה נדחתה. אפשר לאשר אותה ידנית בהגדרות המערכת.</string>
    <string name="onboarding_open_settings">פתח הגדרות</string>

